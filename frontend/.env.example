# FastAPI Backend URL (Server-side requests from Next.js BFF)
FASTAPI_BACKEND_URL=http://localhost:8000

# Next.js Application URL (Canonical origin for CSRF and routing)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Session cookie encryption or signing secret (32+ characters)
SESSION_SECRET=change-me-to-a-random-32-char-session-secret-phrase
