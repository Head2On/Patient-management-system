# Application
APP_NAME=Patient Management System
APP_VERSION=1.0.0
DEBUG=True

# Security
SECRET_KEY=change-me-to-a-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database (Docker Compose uses service names, not localhost)
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/patient_management
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/patient_management_test

# Redis (Docker Compose service name)
REDIS_URL=redis://redis:6379

# Rate limiting
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW=300